<IfModule mod_rewrite.c>
    RewriteEngine On

    # Allow only requests from localhost referer
    RewriteCond %{HTTP_REFERER} !^http://localhost/alijislibrary/ [NC]
    RewriteRule ^ - [F,L]

</IfModule>

<IfModule mod_headers.c>
    # Prevent all framing
    Header always set X-Frame-Options "DENY"

    # Add Content Security Policy frame-ancestors (optional but better)
    Header always set Content-Security-Policy "frame-ancestors 'none'"

</IfModule>
